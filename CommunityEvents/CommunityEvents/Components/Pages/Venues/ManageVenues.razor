@page "/admin/venues"
@using CommunityEvents.Interfaces
@using CommunityEvents.Models
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IVenueService VenueService
@rendermode InteractiveServer

<PageTitle>Manage Venues</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold"><i class="bi bi-building me-2 text-primary"></i>Manage Venues</h1>
    <button class="btn btn-primary" @onclick="() => ShowForm(null)">
        <i class="bi bi-plus-circle me-2"></i>Add Venue
    </button>
</div>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @messageClass alert-dismissible">
        @message
        <button type="button" class="btn-close" @onclick="() => message = string.Empty"></button>
    </div>
}

@if (showForm)
{
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light fw-semibold">
            @(editingVenue?.Id > 0 ? "Edit Venue" : "New Venue")
        </div>
        <div class="card-body">
            <EditForm Model="editingVenue!" OnValidSubmit="SaveVenue">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Name *</label>
                        <InputText class="form-control" @bind-Value="editingVenue!.Name" />
                        <ValidationMessage For="() => editingVenue.Name" class="text-danger small" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Capacity *</label>
                        <InputNumber class="form-control" @bind-Value="editingVenue!.Capacity" />
                        <ValidationMessage For="() => editingVenue.Capacity" class="text-danger small" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Address *</label>
                        <InputText class="form-control" @bind-Value="editingVenue!.Address" />
                        <ValidationMessage For="() => editingVenue.Address" class="text-danger small" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Description</label>
                        <InputTextArea class="form-control" @bind-Value="editingVenue!.Description" rows="2" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Contact Phone</label>
                        <InputText class="form-control" @bind-Value="editingVenue!.ContactPhone" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Contact Email</label>
                        <InputText class="form-control" @bind-Value="editingVenue!.ContactEmail" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save me-1"></i>Save
                    </button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => showForm = false">Cancel</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (venues is null)
{
    <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-4">
        @foreach (var venue in venues)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title fw-bold"><i class="bi bi-building me-2 text-primary"></i>@venue.Name</h5>
                        <p class="text-muted small mb-2"><i class="bi bi-geo-alt me-1"></i>@venue.Address</p>
                        <p class="mb-2"><span class="badge bg-primary">Capacity: @venue.Capacity</span></p>
                        @if (venue.Description is not null)
                        {
                            <p class="text-muted small">@venue.Description</p>
                        }
                    </div>
                    <div class="card-footer bg-transparent d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowForm(venue)">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteVenue(venue.Id)">
                            <i class="bi bi-trash me-1"></i>Delete
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IEnumerable<Venue>? venues;
    private Venue? editingVenue;
    private bool showForm;
    private string message = string.Empty;
    private string messageClass = "alert-info";

    protected override async Task OnInitializedAsync() => await LoadVenues();

    private async Task LoadVenues() => venues = await VenueService.GetAllVenuesAsync();

    private void ShowForm(Venue? venue)
    {
        editingVenue = venue is null ? new Venue() : new Venue
        {
            Id = venue.Id, Name = venue.Name, Address = venue.Address,
            Capacity = venue.Capacity, Description = venue.Description,
            ContactPhone = venue.ContactPhone, ContactEmail = venue.ContactEmail
        };
        showForm = true;
    }

    private async Task SaveVenue()
    {
        try
        {
            if (editingVenue!.Id == 0)
                await VenueService.CreateVenueAsync(editingVenue);
            else
                await VenueService.UpdateVenueAsync(editingVenue);
            message = "Venue saved successfully."; messageClass = "alert-success";
            showForm = false;
        }
        catch (Exception ex) { message = ex.Message; messageClass = "alert-danger"; }
        await LoadVenues();
    }

    private async Task DeleteVenue(int id)
    {
        try { await VenueService.DeleteVenueAsync(id); message = "Venue deleted."; messageClass = "alert-info"; }
        catch (Exception ex) { message = ex.Message; messageClass = "alert-danger"; }
        await LoadVenues();
    }
}
