@page "/events"
@using CommunityEvents.Interfaces
@using CommunityEvents.Models
@inject IEventService EventService
@inject IVenueService VenueService
@rendermode InteractiveServer

<PageTitle>Browse Events</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold"><i class="bi bi-calendar3 me-2 text-primary"></i>Community Events</h1>
</div>

<!-- Filter Panel -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-header bg-light fw-semibold">
        <i class="bi bi-funnel me-2"></i>Filter Events
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Search</label>
                <input type="text" class="form-control" placeholder="Name, description…"
                       @bind="searchQuery" @bind:after="ApplyFilters" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Date</label>
                <input type="date" class="form-control" @bind="selectedDate" @bind:after="ApplyFilters" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Venue</label>
                <select class="form-select" @bind="selectedVenueId" @bind:after="ApplyFilters">
                    <option value="0">All Venues</option>
                    @foreach (var venue in venues)
                    {
                        <option value="@venue.Id">@venue.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Activity Type</label>
                <select class="form-select" @bind="selectedActivityType" @bind:after="ApplyFilters">
                    <option value="">All Types</option>
                    @foreach (var type in Enum.GetValues<ActivityType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearFilters">
                <i class="bi bi-x-circle me-1"></i>Clear Filters
            </button>
        </div>
    </div>
</div>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
        <p class="mt-2 text-muted">Loading events…</p>
    </div>
}
else if (!filteredEvents.Any())
{
    <div class="alert alert-info text-center">
        <i class="bi bi-calendar-x me-2"></i>No events match your filters.
    </div>
}
else
{
    <p class="text-muted mb-3">Showing <strong>@filteredEvents.Count()</strong> event(s)</p>
    <div class="row g-4">
        @foreach (var evt in filteredEvents)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header d-flex justify-content-between align-items-center
                                @(evt.Type == EventType.Virtual ? "bg-info" : evt.Type == EventType.Hybrid ? "bg-warning" : "bg-primary") text-white">
                        <span><i class="bi bi-@GetTypeIcon(evt.Type) me-1"></i>@evt.Type</span>
                        <small>@evt.EventDate.ToString("dd MMM yyyy")</small>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@evt.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">
                            @(evt.Description.Length > 120 ? evt.Description[..120] + "…" : evt.Description)
                        </p>
                        <div class="mb-2">
                            <small class="text-muted"><i class="bi bi-clock me-1"></i>@evt.StartTime.ToString(@"hh\:mm") – @evt.EndTime.ToString(@"hh\:mm")</small>
                        </div>
                        <div class="mb-3 d-flex justify-content-between">
                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@evt.Venue?.Name</small>
                            @if (evt.IsFull)
                            {
                                <span class="badge bg-danger">Full</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@evt.AvailableSpots left</span>
                            }
                        </div>
                        @if (evt.EventActivities.Any())
                        {
                            <div class="mb-2">
                                @foreach (var ea in evt.EventActivities.Take(3))
                                {
                                    <span class="badge bg-secondary me-1">@ea.Activity?.Name</span>
                                }
                            </div>
                        }
                        <a href="/events/@evt.Id" class="btn btn-outline-primary btn-sm mt-auto">
                            <i class="bi bi-eye me-1"></i>Details &amp; Register
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IEnumerable<Event> filteredEvents = Enumerable.Empty<Event>();
    private IEnumerable<Venue> venues = Enumerable.Empty<Venue>();
    private bool isLoading = true;

    private string? searchQuery;
    private DateTime? selectedDate;
    private int selectedVenueId;
    private string? selectedActivityType;

    protected override async Task OnInitializedAsync()
    {
        venues = await VenueService.GetAllVenuesAsync();
        await ApplyFilters();
    }

    private async Task ApplyFilters()
    {
        isLoading = true;
        ActivityType? actType = Enum.TryParse<ActivityType>(selectedActivityType, out var parsed) ? parsed : null;
        filteredEvents = await EventService.FilterEventsAsync(selectedDate, selectedVenueId > 0 ? selectedVenueId : null, actType, searchQuery);
        isLoading = false;
    }

    private async Task ClearFilters()
    {
        searchQuery = null;
        selectedDate = null;
        selectedVenueId = 0;
        selectedActivityType = null;
        await ApplyFilters();
    }

    private static string GetTypeIcon(EventType t) => t switch
    {
        EventType.Virtual => "camera-video",
        EventType.Hybrid => "layers",
        _ => "geo-alt"
    };
}
