@page "/admin/events/create"
@page "/admin/events/edit/{Id:int}"
@using CommunityEvents.Interfaces
@using CommunityEvents.Models
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@inject IEventService EventService
@inject IVenueService VenueService
@inject IActivityService ActivityService
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(IsEditing ? "Edit Event" : "Create Event")</PageTitle>

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/admin/events">Events</a></li>
        <li class="breadcrumb-item active">@(IsEditing ? "Edit" : "Create")</li>
    </ol>
</nav>

<h1 class="fw-bold mb-4">
    <i class="bi bi-@(IsEditing ? "pencil" : "plus-circle") me-2 text-primary"></i>
    @(IsEditing ? "Edit Event" : "Create New Event")
</h1>

@if (isLoading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <EditForm Model="model" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold">Event Name *</label>
                                <InputText class="form-control" @bind-Value="model.Name" placeholder="e.g. Summer Community Festival" />
                                <ValidationMessage For="() => model.Name" class="text-danger small" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Description *</label>
                                <InputTextArea class="form-control" @bind-Value="model.Description" rows="4"
                                              placeholder="Describe the event…" />
                                <ValidationMessage For="() => model.Description" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Date *</label>
                                <InputDate class="form-control" @bind-Value="model.EventDate" />
                                <ValidationMessage For="() => model.EventDate" class="text-danger small" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">Start Time *</label>
                                <input type="time" class="form-control" value="@model.StartTime.ToString(@"hh\:mm")"
                                       @onchange="e => model.StartTime = TimeSpan.Parse(e.Value!.ToString()!)" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-semibold">End Time *</label>
                                <input type="time" class="form-control" value="@model.EndTime.ToString(@"hh\:mm")"
                                       @onchange="e => model.EndTime = TimeSpan.Parse(e.Value!.ToString()!)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Venue *</label>
                                <InputSelect class="form-select" @bind-Value="model.VenueId">
                                    <option value="0">— Select Venue —</option>
                                    @foreach (var venue in venues)
                                    {
                                        <option value="@venue.Id">@venue.Name (@venue.Capacity cap.)</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => model.VenueId" class="text-danger small" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Max Capacity *</label>
                                <InputNumber class="form-control" @bind-Value="model.MaxCapacity" min="1" />
                                <ValidationMessage For="() => model.MaxCapacity" class="text-danger small" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-semibold">Event Type</label>
                                <InputSelect class="form-select" @bind-Value="model.Type">
                                    @foreach (var type in Enum.GetValues<EventType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Activities</label>
                                <div class="row g-2">
                                    @foreach (var activity in availableActivities)
                                    {
                                        <div class="col-md-4">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       id="act_@activity.Id"
                                                       checked="@selectedActivityIds.Contains(activity.Id)"
                                                       @onchange="e => ToggleActivity(activity.Id, (bool)e.Value!)" />
                                                <label class="form-check-label" for="act_@activity.Id">
                                                    @activity.Name
                                                    <span class="badge bg-secondary ms-1">@activity.Type</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mt-3">@errorMessage</div>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                                @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                <i class="bi bi-save me-1"></i>@(IsEditing ? "Save Changes" : "Create Event")
                            </button>
                            <a href="/admin/events" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private EventFormModel model = new();
    private IEnumerable<Venue> venues = Enumerable.Empty<Venue>();
    private IEnumerable<Activity> availableActivities = Enumerable.Empty<Activity>();
    private HashSet<int> selectedActivityIds = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private string errorMessage = string.Empty;

    private bool IsEditing => Id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        venues = await VenueService.GetAllVenuesAsync();
        availableActivities = await ActivityService.GetAllActivitiesAsync();

        if (IsEditing)
        {
            var evt = await EventService.GetEventDetailsAsync(Id!.Value);
            if (evt is not null)
            {
                model = new EventFormModel
                {
                    Name = evt.Name,
                    Description = evt.Description,
                    EventDate = evt.EventDate,
                    StartTime = evt.StartTime,
                    EndTime = evt.EndTime,
                    VenueId = evt.VenueId,
                    MaxCapacity = evt.MaxCapacity,
                    Type = evt.Type
                };
                selectedActivityIds = evt.EventActivities.Select(ea => ea.ActivityId).ToHashSet();
            }
        }
        else
        {
            model.EventDate = DateTime.Today.AddDays(7);
            model.StartTime = new TimeSpan(9, 0, 0);
            model.EndTime = new TimeSpan(17, 0, 0);
            model.MaxCapacity = 50;
        }

        isLoading = false;
    }

    private void ToggleActivity(int activityId, bool selected)
    {
        if (selected) selectedActivityIds.Add(activityId);
        else selectedActivityIds.Remove(activityId);
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        try
        {
            Event evt;
            if (IsEditing)
            {
                var existing = await EventService.GetEventDetailsAsync(Id!.Value) ?? throw new Exception("Event not found.");
                existing.Name = model.Name;
                existing.Description = model.Description;
                existing.EventDate = model.EventDate;
                existing.StartTime = model.StartTime;
                existing.EndTime = model.EndTime;
                existing.VenueId = model.VenueId;
                existing.MaxCapacity = model.MaxCapacity;
                existing.Type = model.Type;
                evt = await EventService.UpdateEventAsync(existing);

                // Sync activities
                var currentIds = existing.EventActivities.Select(ea => ea.ActivityId).ToHashSet();
                foreach (var toAdd in selectedActivityIds.Except(currentIds))
                    await EventService.AddActivityToEventAsync(evt.Id, toAdd, 0, null);
                foreach (var toRemove in currentIds.Except(selectedActivityIds))
                    await EventService.RemoveActivityFromEventAsync(evt.Id, toRemove);
            }
            else
            {
                var newEvent = new Event
                {
                    Name = model.Name,
                    Description = model.Description,
                    EventDate = model.EventDate,
                    StartTime = model.StartTime,
                    EndTime = model.EndTime,
                    VenueId = model.VenueId,
                    MaxCapacity = model.MaxCapacity,
                    Type = model.Type
                };
                evt = await EventService.CreateEventAsync(newEvent);

                int order = 1;
                foreach (var actId in selectedActivityIds)
                    await EventService.AddActivityToEventAsync(evt.Id, actId, order++, null);
            }

            Navigation.NavigateTo("/admin/events");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally { isSubmitting = false; }
    }

    private class EventFormModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Name { get; set; } = string.Empty;
        [System.ComponentModel.DataAnnotations.Required]
        public string Description { get; set; } = string.Empty;
        public DateTime EventDate { get; set; }
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
        public int VenueId { get; set; }
        [System.ComponentModel.DataAnnotations.Range(1, 100_000)]
        public int MaxCapacity { get; set; }
        public EventType Type { get; set; } = EventType.InPerson;
    }
}
